{
  "buildCommand": "",
  "installCommand": "",
  "framework": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/feed", "permanent": false }
  ],
  "rewrites": [
    { "source": "/feed", "destination": "/feed.html" },
    { "source": "/token", "destination": "/token.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/flows", "destination": "/flows.html" }
  ]
}
